# Copy to .streamlit/secrets.toml for local dev, or paste into
# Streamlit Cloud -> App settings -> Secrets for deployed apps.
# Only one key is required (pick your provider in the sidebar).

ANTHROPIC_API_KEY = "sk-ant-..."
OPENAI_API_KEY = "sk-..."

# Login access key for the app's gate page.
# If omitted, the app runs in demo mode with access key "awslz".
APP_PASSWORD = "choose-a-strong-passphrase"

# OR multi-user mode (takes precedence over APP_PASSWORD).
# Each user gets their own scenario workspace.
# [users]
# ajit = "passphrase-1"
# guest = "passphrase-2"

# Durable storage. REQUIRED on Streamlit Community Cloud (its filesystem is
# ephemeral) — point at a free managed Postgres (Neon / Supabase). If omitted,
# the app falls back to a local SQLite file (fine for local/persistent hosts).
# DATABASE_URL = "postgresql://user:pass@host/dbname?sslmode=require"
