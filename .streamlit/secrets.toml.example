# Copy to .streamlit/secrets.toml for local dev, or paste into
# Streamlit Cloud -> App settings -> Secrets for deployed apps.
# Only one key is required (pick your provider in the sidebar).

ANTHROPIC_API_KEY = "sk-ant-..."
OPENAI_API_KEY = "sk-..."

# Login access key for the app's gate page.
# If omitted, the app runs in demo mode with access key "awslz".
APP_PASSWORD = "choose-a-strong-passphrase"
